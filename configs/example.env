# HTTP Server configuration
HTTP_ADDR=:8080

# Database connection URL (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agent_frei_igi?sslmode=disable

# GitHub Integration (to be filled later)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Encryption key (standard 32-byte key Base64 encoded)
# Example of generation: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Telegram Alerts Integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
FF_TELEGRAM=false

# Feature Flags
FF_PUBLISH_COMMENTS=false
FF_REVIEW_SIGNATURE=true
FF_APP_BOT_PUBLISH_FALLBACK=false
FF_MULTI_USER_PUBLISH=false

# LLM Providers Configuration
LLM_PROVIDER=agy
LLM_FALLBACK_PROVIDER=grok
LLM_TIMEOUT=120s
LLM_MAX_OUTPUT_TOKENS=8192
FINDING_CONFIDENCE_MIN=0.55
PROMPT_BUDGET_TOKENS=100000
AGY_BIN=agy
GROK_BIN=grok

# Reviewer Logins (comma-separated machine user accounts)
REVIEWER_LOGINS=
